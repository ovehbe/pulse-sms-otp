{
  "manifest_version": 3,
  "name": "Pulse SMS OTP Helper",
  "version": "1.0.0",
  "description": "Automatically detect and copy OTP codes from Pulse SMS conversation list",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://pulsesms.app/*",
    "https://home.pulsesms.app/*",
    "https://*.pulsesms.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://pulsesms.app/*",
        "https://home.pulsesms.app/*",
        "https://*.pulsesms.app/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
